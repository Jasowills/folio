{
  "moduleFileExtensions": ["js", "json", "ts"],
  "testEnvironment": "node",
  "testMatch": ["**/*.e2e-spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "rootDir": "..",
  "setupFiles": ["./test/e2e-setup.ts"],
  "moduleNameMapper": {
    "^@opencode-ai/sdk/v2$": "<rootDir>/../node_modules/@opencode-ai/sdk/dist/v2/index.js"
  }
}
